# Copy to .env and set ONE real key. .env is gitignored and dockerignored — never commit it.

# Which configured provider to try first; the other (if a key is set) is the fallback.
LLM_PROVIDER=openai

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile

# Reliability budget (seconds). Judge limit per request is 30 s.
# LLM_TIMEOUT_S=20
# LLM_ATTEMPT_TIMEOUT_S=12
# LLM_HEDGE_AFTER_S=2.5
# LLM_CACHE=1

PORT=8000
